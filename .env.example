# Development Configs
# Generate one with: echo "LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY = ""
# Generate one with: echo "LITELLM_SALT_KEY=sk-$(openssl rand -hex 24)". Never change it once keys exist (it encrypts stored credentials).
LITELLM_SALT_KEY = ""
# Local Postgres from docker-compose (host port 5433). Inside Docker use db:5432 instead.
DATABASE_URL = "postgresql://llmproxy:dbpassword9090@localhost:5433/litellm"
# Use the bundled model price list instead of fetching it from GitHub.
LITELLM_LOCAL_MODEL_COST_MAP = "True"
STORE_MODEL_IN_DB = "True"
